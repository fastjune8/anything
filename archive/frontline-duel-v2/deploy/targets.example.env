# 이 파일을 deploy/targets.env 로 복사해서 값을 채운다. (targets.env 는 git 에 올라가지 않는다)
SSH_KEY=/path/to/ssh-key.key
SSH_USER=opc

# 라이브(prod): 실제 유저가 접속하는 서버
PROD_HOST=1.2.3.4
PROD_PORT=3000
PROD_DIR=frontline-duel
PROD_SERVICE=frontline-duel

# 스테이징: 같은 서버의 다른 포트 (배포 전 최종 확인용). 자원이 제한된 채로 돌아간다.
STAGING_HOST=1.2.3.4
STAGING_PORT=3001
STAGING_DIR=frontline-duel-staging
STAGING_SERVICE=frontline-duel-staging
