{
  "name": "frontier",
  "version": "2.0.0",
  "description": "FRONTIER — 봇이 섞이는 웹 FPS 자유 대전",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "PORT=${PORT:-3002} APP_ENV=dev node --watch server/index.js",
    "test": "node tests/unit.test.mjs && node tests/rules.test.mjs && node tests/tdm.test.mjs && node tests/custom.test.mjs && node tests/loadout.test.mjs && node tests/protocol.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:all": "eslint . && npm test && node tests/browser.test.mjs",
    "deploy:prod": "./deploy/deploy.sh prod",
    "rollback:prod": "./deploy/deploy.sh prod --rollback",
    "lint": "eslint .",
    "check": "eslint . && npm test",
    "test:unit": "node tests/unit.test.mjs"
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0"
  }
}
